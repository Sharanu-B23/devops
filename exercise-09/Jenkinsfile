pipeline {
    agent any
    options {
        timeout(time: 15, unit: 'MINUTES')
        disableConcurrentBuilds()
    }
    environment {
        APP_DIR   = 'exercise-09/app'
        IMAGE     = 'ex09-flask:ci'
        CONTAINER = 'ex09-flask-ci'
        NETWORK   = 'ex09-net'
        HOST_PORT = '5009'
    }
    stages {
        stage('Build') {
            steps {
                sh 'docker version --format "{{.Server.Version}}"'
                sh 'docker build -t "$IMAGE" "$APP_DIR"'
            }
        }
        stage('Test') {
            steps {
                sh '''
                    python3 -m venv .venv
                    . .venv/bin/activate
                    pip install --quiet -r "$APP_DIR/requirements-dev.txt"
                    python -m pytest "$APP_DIR" -v
                '''
            }
        }
        stage('Deploy') {
            steps {
                sh '''
                    docker rm -f "$CONTAINER" >/dev/null 2>&1 || true
                    docker run -d --name "$CONTAINER" --network "$NETWORK" -p "$HOST_PORT:5000" "$IMAGE"
                '''
            }
        }
        stage('Run Application') {
            steps {
                sh '''
                    for i in $(seq 1 20); do
                        if curl -fsS "http://$CONTAINER:5000/health"; then
                            echo ""
                            echo "HEALTH CHECK PASSED"
                            exit 0
                        fi
                        echo "waiting for application ($i/20)"
                        sleep 2
                    done
                    echo "HEALTH CHECK FAILED"
                    docker logs "$CONTAINER" || true
                    exit 1
                '''
                sh 'curl -fsS "http://$CONTAINER:5000/"'
            }
        }
        stage('Cleanup') {
            steps {
                sh '''
                    docker rm -f "$CONTAINER" >/dev/null 2>&1 || true
                    rm -rf .venv
                '''
            }
        }
    }
    post {
        always {
            sh 'docker rm -f "$CONTAINER" >/dev/null 2>&1 || true'
            sh 'rm -rf .venv || true'
        }
        success { echo 'PIPELINE SUCCESS' }
        failure { echo 'PIPELINE FAILED' }
    }
}
